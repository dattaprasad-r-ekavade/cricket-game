<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SuperCricket.Content\SuperCricket.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\characters\practice-batter-humanoid.glb" Link="Fixtures\practice-batter-humanoid.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\characters\practice-bowler-humanoid.glb" Link="Fixtures\practice-bowler-humanoid.glb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\characters\wp19\character-variants.json" Link="Fixtures\wp19\character-variants.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\characters\wp19\*.glb" Link="Fixtures\wp19\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\characters\wp19\textures\*.png" Link="Fixtures\wp19\textures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\stadium\stadium-layout.json" Link="Fixtures\wp20\stadium-layout.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\stadium\props\*.glb" Link="Fixtures\wp20\props\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
