    <None Include="..\..\assets\teams\coastal-xi.json" Link="Assets\Teams\coastal-xi.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\teams\highland-xi.json" Link="Assets\Teams\highland-xi.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
